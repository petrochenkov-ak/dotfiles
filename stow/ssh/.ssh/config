# 1. Сначала включаем специфичные настройки проектов (самый высокий приоритет)
Include config.d/*
Include config.d/*/*
Include config.d/*/*/*

# 2. Глобальные настройки для всех хостов (низший приоритет)
Host *
    # --- Автоматизация ключей (macOS Keychain) ---
    AddKeysToAgent yes
    UseKeychain yes
    # Убрали IdentityFile id_rsa, чтобы не перебирать лишнее

    # --- Оптимизация соединения (Multiplexing) ---
    # Позволяет открывать новые терминалы мгновенно через один TCP-канал
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 2h

    # --- Стабильность (Keep-alive) ---
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ConnectTimeout 3

    # --- Безопасность и удобство ---
    StrictHostKeyChecking accept-new
    # (Вместо /dev/null лучше использовать accept-new:
    # он сам добавит новый хост, но предупредит, если ключ старого изменился)

    LogLevel ERROR

    # Очистка окружения (чтобы локальные переменные не мусорили на сервере)
    SendEnv -*
