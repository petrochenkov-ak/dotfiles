# https://github.com/Homebrew/homebrew-cask/blob/master/USAGE.md
HOMEBREW_CASK_OPTS="--appdir=~/Applications"
HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_PREFIX=/Volumes/ssd-external/homebrew
HOMEBREW_CELLAR=/Volumes/ssd-external/homebrew/Cellar
HOMEBREW_REPOSITORY=/Volumes/ssd-external/homebrew
HOMEBREW_CACHE=/Volumes/ssd-external/cache/Homebrew
HOMEBREW_TEMP=/Volumes/ssd-external/tmp
HOMEBREW_LOGS=/Volumes/ssd-external/logs/Homebrew
PATH=/Volumes/ssd-external/homebrew/bin:/Volumes/ssd-external/homebrew/sbin:$PATH
MANPATH=/Volumes/ssd-external/homebrew/share/man:${MANPATH:-}
INFOPATH=/Volumes/ssd-external/homebrew/share/info:${INFOPATH:-}

TMPDIR=/Volumes/ssd-external/tmp
XDG_CACHE_HOME=/Volumes/ssd-external/cache
PIP_CACHE_DIR=/Volumes/ssd-external/cache/pip
UV_CACHE_DIR=/Volumes/ssd-external/cache/uv
POETRY_CACHE_DIR=/Volumes/ssd-external/cache/pypoetry
npm_config_cache=/Volumes/ssd-external/cache/npm
CARGO_HOME=/Volumes/ssd-external/cache/cargo
HF_HOME=/Volumes/ssd-external/cache/huggingface
OLLAMA_MODELS=/Volumes/ssd-external/cache/ollama
