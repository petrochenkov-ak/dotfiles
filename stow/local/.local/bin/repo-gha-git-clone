#!/usr/bin/env bash
set -euo pipefail
{ set +x; } 2>/dev/null

if [ $# -lt 1 ]; then
  printf 'Usage: repo-gha-git-clone TARGET_DIR\n' >&2
  exit 1
fi

TARGET_DIR="$1"
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 1
ORIGIN_URL=$(git remote get-url origin 2>/dev/null) || exit 1

is_shallow=$(git rev-parse --is-shallow-repository 2>/dev/null || printf 'false')
if [ "$is_shallow" = "true" ]; then
  ( set -x; git fetch -q --unshallow origin ) || exit 1
fi

(
  set -x
  git -c core.hooksPath=/dev/null clone -q --no-hardlinks --branch "$BRANCH_NAME" . "$TARGET_DIR"
  git -C "$TARGET_DIR" remote set-url origin "$ORIGIN_URL"
) || exit 1
