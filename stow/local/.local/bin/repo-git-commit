#!/usr/bin/env bash
{ set +x; } 2>/dev/null


current_branch=$(git symbolic-ref --short HEAD) || exit 1
status=$(git status --porcelain) || exit 1

( set -x; repo-git-dir-check ) || exit 1

( set -x; git init -q ) || exit 1
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  ( set -x; git commit -q --allow-empty -m "chore: initial commit" ) || exit 1
  exit 0
fi

[ -z "$status" ] && exit 0

if [ "$current_branch" = "main" ]; then
  echo "Error: direct commits to main are blocked. Switch to a feature branch." >&2
  exit 1
fi

( set -x; git add -A ) || exit 1
commit_msg=$( set -x; repo-git-commit-msg-gen ) || exit 1
( set -x; git commit -q -m "$commit_msg" ) || exit 1
