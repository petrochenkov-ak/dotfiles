#!/usr/bin/env bash

TIMEOUT=10

if [ -z "${DOCKER_REGISTRY_HOST}" ]; then
    echo "ERROR: DOCKER_REGISTRY_HOST is not set" >&2
    exit 1
fi

if ! ( set -x; curl -kIs --connect-timeout ${TIMEOUT} "https://${DOCKER_REGISTRY_HOST}/v2/" ) > /dev/null; then
    echo "ERROR: Registry ${DOCKER_REGISTRY_HOST} is dead or blocked" >&2
    exit 1
fi;:
