#!/usr/bin/env bash
{ set +x; } 2>/dev/null

if [ $# -lt 1 ]; then
  printf 'Usage: docker-run-gha IMAGE [ARGS...]\n' >&2
  exit 1
fi

GITHUB_RUN_ID=42
GITHUB_WORKSPACE="/github/workspace"
IMAGE="registry.docker.internal:5000/$1"
shift

COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null) || exit 1
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main") || exit 1

GLOBAL_IGNORE=$(git config --get core.excludesfile) || exit 1
GLOBAL_IGNORE="${GLOBAL_IGNORE/#\~/$HOME}"

( set -x; docker run --rm \
  -v "$PWD:/github/workspace" \
  -v "$GLOBAL_IGNORE:/etc/gitignore_global:ro" \
  -e GIT_CONFIG_PARAMETERS="'core.excludesfile=/etc/gitignore_global'" \
  -w /github/workspace \
  -e GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
  -e GITHUB_RUN_ID="$GITHUB_RUN_ID" \
  -e GITHUB_SHA="$COMMIT_SHA" \
  -e GITHUB_REF="refs/heads/$BRANCH_NAME" \
  "$IMAGE" \
  "$@" )
