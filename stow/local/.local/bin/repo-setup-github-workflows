#!/usr/bin/env bash
{ set +x; } 2>/dev/null

SRC_DIR=~/git/petrochenkov-ak/dotfiles/repo-dotfiles

if [ -e docker ] || [ -e python ]; then
    ( set -x; gh-workflow-cp "main-ci.yaml" ) || exit 1
fi
if [ -e docker/docker-bake.hcl ]; then
    ( set -x; gh-workflow-cp "docker-bake.yaml" ) || exit 1
fi
if [ -e /python ]; then
    ( set -x; gh-workflow-cp "python-ci.yaml" ) || exit 1
fi
