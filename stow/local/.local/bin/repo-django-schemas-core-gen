#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

export DJANGO_DATABASE_URL=postgres://postgres:@127.0.0.1:5433/codegen_local

( set -x; "${BASH_SOURCE%/*}"/repo-psql-codegen-init ) || exit
while read -r pkg; do
    pkg_name="${pkg##*/}"
    ( set -x; .venv/bin/python -W ignore::FutureWarning -m django_package_schemas_gen "${pkg}" ) || exit
done < <(find python/packages -mindepth 1 -maxdepth 1 -type d -name "*_models_gen" | grep -v tasks_models_gen)
