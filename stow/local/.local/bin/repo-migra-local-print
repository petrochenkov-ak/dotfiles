#!/usr/bin/env bash
{ set +x; } 2>/dev/null

# {project}_local - MIGRA_SOURCE_URL
# migra_local -  MIGRA_TARGET_URL

export PGSERVICEFILE=~/.config/postgresql/pg_service.local.conf
export PGPASSFILE="${HOME}/.config/postgresql/pgpass"
export PGOPTIONS="--client-min-messages=warning"
export MIGRA_TARGET_URL=postgresql://postgres:@127.0.0.1:5434/migra_local

. .env.local || exit 1
[[ -z $DJANGO_DATABASE_URL ]] && echo "ERROR: .env.local DJANGO_DATABASE_URL not defined" && exit 1
! [ -e "$PGPASSFILE" ] && echo "ERROR: $PGPASSFILE not exists" && exit 1
! [ -e "$PGSERVICEFILE" ] && echo "ERROR: $PGSERVICEFILE not exists" && exit 1

MIGRA_SOURCE_URL="$DJANGO_DATABASE_URL"
MAINTENANCE_URL=$(echo "$MIGRA_TARGET_URL" | sed "s|\/[^/]*$|/postgres|")

( set -x; dropdb --maintenance-db="$MAINTENANCE_URL" -f --if-exists migra_local )
( set -x; createdb --maintenance-db="$MAINTENANCE_URL" migra_local )

for attempt in {1..10}; do
    success=true

    while read -r file_path; do
        psql -v ON_ERROR_STOP=1 -d "service=migra_local" -f "$file_path" &>/dev/null || success=false
    done < <(find sql/src -name "*.sql" -type f)
done
[[ $success == false ]] && {
    while read -r file_path; do
        psql -v ON_ERROR_STOP=1 -d "service=migra_local" -f "$file_path" &>/dev/null
    done < <(find sql/src -name "*.sql" -type f)
    exit 1
}

( set -x; migra --unsafe "$MIGRA_SOURCE_URL" "$MIGRA_TARGET_URL" )
