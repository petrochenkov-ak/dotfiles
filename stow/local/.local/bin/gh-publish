#!/usr/bin/env bash
{ set +x; } 2>/dev/null

[[ "$PWD" != */git/* ]] && echo "ERROR: $PWD" 1>&2 && exit 1

( set -x; git init -q ) || exit 1
( set -x; git-checkout-ai-branch ) || exit 1
( set -x; git add -A ) || exit 1
( set -x; git-commit ) || exit 1
( set -x; gh-repo-create ) || exit 1
( set -x; git-push ) || exit 1
( set -x; gh-pr-sync ) || exit 1
( set -x; gh-pr-cleanup ) || exit 1
