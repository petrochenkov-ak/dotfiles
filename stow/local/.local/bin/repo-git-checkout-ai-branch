#!/usr/bin/env bash
{ set +x; } 2>/dev/null

export BASH_ENV=~/.bashrc

( set -x; git reset ) >/dev/null 2>&1

commits_count=$(git rev-list --count main 2>/dev/null || echo "0")
current_branch=$(set -x; git symbolic-ref --short HEAD) || exit 1
status=$(git status -s) || exit 1

[[ "$current_branch" == "main" ]] && [[ $commits_count == 0 ]] && {
    echo "SKIP: main is empty" && exit 0
}
[ -z "$status" ] && exit 0

ai_branch_name="$(set -x; python3 -m ci_git_branch_name_gen)" || exit 1
[[ -z "$ai_branch_name" ]] && echo "ERROR: ai_branch name empty" && exit 1

ai_branch_name="${ai_branch_name}-$(date +%s)"

( set -x; git stash -u ) || exit 1

if git remote get-url origin >/dev/null 2>&1; then
    ( set -x; git fetch -q origin main ) || exit 1
    if git show-ref --verify --quiet refs/remotes/origin/main; then
        ( set -x; git checkout -B main origin/main -q ) || exit 1
    fi
fi

( set -x; git checkout -b "$ai_branch_name" -q ) || exit 1

if ! ( set -x; git stash pop -q ); then
    ( set -x; git read-tree --reset -u stash@{0} ) || exit 1
    ( set -x; git stash drop -q ) || exit 1
fi
