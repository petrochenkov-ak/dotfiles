#!/usr/bin/env bash
{ set +x; } 2>/dev/null

[[ $# != 2 ]] && echo "usage: ${0##*/} ssh_host gb_min" && exit 1

THRESHOLD_MB=$(($2 * 1024))

# df -m / | awk 'NR==2 {print $4}'
FREE_SPACE_MB="$(ssh "$1" "df -m / | awk 'NR==2 {print \$4}'")" || exit 1

if [ "$FREE_SPACE_MB" -lt "$THRESHOLD_MB" ]; then
    echo "WARN: $1 ${FREE_SPACE_MB}Mb free"
fi;:
