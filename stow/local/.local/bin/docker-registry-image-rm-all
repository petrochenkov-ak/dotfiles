#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <name>" >&2
  exit 1
fi

if [[ -z "$1" || "$1" == *:* ]]; then
  echo "Error: invalid name '$1' (expected 'name' without ':tag')" >&2
  exit 1
fi

: "${DOCKER_REGISTRY_HOST:?DOCKER_REGISTRY_HOST is required}"

name="$1"

tags=$( set -x; crane ls --insecure "${DOCKER_REGISTRY_HOST}/${name}" ) || exit 1

while IFS= read -r tag; do
  [[ -z "$tag" ]] && continue
  ( set -x; crane delete --insecure "${DOCKER_REGISTRY_HOST}/${name}:${tag}" ) || true
done <<< "$tags"

( set -x; ssh "registry.docker.internal" "docker exec docker-registry-prod rm -rf '/var/lib/registry/docker/registry/v2/repositories/${name}'" ) || exit 1
