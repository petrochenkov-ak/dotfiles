#!/usr/bin/env bash
{ set +x; } 2>/dev/null

( set -x; gh-repo-view-error ) | grep -q "Could not resolve to a Repository" && {
    ( set -x; rm -fr .git ) || exit 1
}
( set -x; repo-setup ) || exit 1
( set -x; git init -q ) || exit 1
( set -x; repo-gh-git-remote-set ) || exit 1
( set -x; repo-git-fetch-rebase-main ) || exit 1
( set -x; repo-git-checkout-ai-branch ) || exit 1
( set -x; repo-git-commit ) || exit 1
( set -x; repo-gh-create ) || exit 1
( set -x; repo-gh-set-secrets ) || exit 1
( set -x; repo-git-push ) || exit 1
( set -x; repo-gh-pr-sync ) || exit 1
( set -x; repo-gh-pr-cleanup ) || exit 1
