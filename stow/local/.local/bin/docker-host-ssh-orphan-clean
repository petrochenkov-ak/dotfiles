#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <ssh_host>" >&2
  exit 1
fi

ssh_host="$1"

orphan_names=$( set -x; docker-host-ssh-orphan-image-list "$ssh_host" ) || exit 1

if [[ -z "$orphan_names" ]]; then
  echo "SKIP: no orphan images to delete on $ssh_host" >&2
  exit 0
fi

while IFS= read -r target; do
  list=$( set -x; ssh "$ssh_host" "docker images --format '{{.Repository}}|{{.Tag}}|{{.Digest}}|{{.ID}}'" ) || exit 1
  to_delete=()
  while IFS='|' read -r repo tag digest id; do
    [[ -z "$repo" ]] && continue
    name="${repo##*/}"

    if [[ "$name" == "$target" || ( "$repo" == "build-cache" && ( "$tag" == "$target" || "$tag" == "$target"-* ) ) ]]; then
      if [[ "$tag" != "<none>" ]]; then
        to_delete+=("${repo}:${tag}")
      elif [[ "$digest" != "<none>" ]]; then
        to_delete+=("${repo}@${digest}")
      else
        to_delete+=("$id")
      fi
    fi
  done <<< "$list"

  if [[ ${#to_delete[@]} -gt 0 ]]; then
    ( set -x; ssh "$ssh_host" "docker image rm -f" "${to_delete[@]}" ) || exit 1
  fi
done <<< "$orphan_names"
