#!/usr/bin/env bash
set -euo pipefail

orphan_images=$( set -x; docker-registry-orphan-image-list ) || exit 1

if [[ -z "$orphan_images" ]]; then
  echo "SKIP: no orphan images to delete" >&2
  exit 0
fi

while IFS= read -r image_name_tag; do
  ( set -x; docker-registry-image-rm "$image_name_tag" ) || exit 1
done <<< "$orphan_images"
