#!/usr/bin/env bash
{ set +x; } 2>/dev/null

[[ $# != 1 ]] && echo "usage: ${0##*/} ssh_host" && exit 1

output="$(ssh host1886648_2 "docker ps -a -f status=exited -f status=restarting --format '{{.Names}}\t{{.Status}}'")" || exit 1
[[ -z $output ]] && exit 0
echo "CRIT: $1 docker ps"
echo "---"
echo "$output"
