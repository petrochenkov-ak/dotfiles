#!/usr/bin/env bash
set -euo pipefail
{ set +x; } 2>/dev/null

repo_full_name=$(repo-gh-full-name) || exit 1
repo_html_url=$(gh repo view "$repo_full_name" --json url --jq .url) || exit 1
{
  echo "ERROR: local repository has no commits, but origin/main already exists"
  echo "$repo_html_url"
  echo ""
  echo "To overwrite remote repository with local files, run:"
  echo "cd $PWD && git add -A && git commit -q --no-verify -m 'chore: initial commit' && git push -q --no-verify -f -u origin main"
} >&2
