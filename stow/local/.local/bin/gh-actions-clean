#!/usr/bin/env bash
{ set +x; } 2>/dev/null

full_name=$(gh-full-name) || exit 1

RUNS=$( (set -x; retry -u success -- gh api repos/$full_name/actions/runs --paginate) 2>&2 | jq -r '.workflow_runs[].id' ) || exit 1

[ -z "$RUNS" ] && echo "No runs found." && exit

IFS=$'\n'
for RUN_ID in $RUNS; do
    ( set -x; retry -u success -- gh api repos/$full_name/actions/runs/$RUN_ID -X DELETE --silent ) || exit
done
