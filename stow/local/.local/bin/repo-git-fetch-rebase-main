#!/usr/bin/env bash
{ set +x; } 2>/dev/null

if [ ! -d .git ]; then
    echo "skip: not a .git"
    exit 0
fi

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "skip: no commits yet (unborn HEAD)"
    exit 0
fi

remote_url="$(git remote -v)" || exit 1

if [[ -z "$remote_url" ]]; then
    echo "skip: no git remote"
    exit 0
fi

if ! ( set -x; git ls-remote --exit-code origin refs/heads/main 2>/dev/null >&2 ); then
    echo "skip: remote ref 'main' does not exist yet"
    exit 0
fi

current_branch=$(git rev-parse --abbrev-ref HEAD) || exit 1
commit_before=$(git rev-parse HEAD) || exit 1

( set -x; git fetch origin main -q ) || exit 1

if [ "$current_branch" == "main" ]; then
    ( set -x; git merge origin/main --ff-only -q ) || exit 1
else
    ( set -x; git rebase origin/main -q ) || exit 1
fi

commit_after=$(git rev-parse HEAD) || exit 1

[ "$commit_before" == "$commit_after" ] && exit 0

escaped_log=$(echo "$git_log" | tr '"' "'" | tr '\n' ' ')
notif_title="repo-git-fetch-rebase-main: ${PWD##*/}"
( set -x; osascript -e 'on run argv' -e 'display notification (item 1 of argv) title (item 2 of argv)' -e 'end run' "$escaped_log" "$notif_title" ) || exit 1

( set -x; /usr/bin/afplay /System/Library/Sounds/Glass.aiff )
