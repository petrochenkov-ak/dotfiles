#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

while read -r pkg; do
    ( set -x; .venv/bin/python -m django_package_serializers_gen "$pkg" ) || exit
done < <(find python/packages -mindepth 1 -maxdepth 1 -type d -name "*_models_gen" | grep -v tasks);:
