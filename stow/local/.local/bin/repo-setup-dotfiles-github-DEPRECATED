#!/usr/bin/env bash
{ set +x; } 2>/dev/null

REPO_PATH="$PWD"

SRC_DIR="$HOME/.local/share/repo-dotfiles"

if [ -e "$REPO_PATH/docker/compose" ]; then
    ( set -x; rm -fr "$REPO_PATH"/.github ) || exit 1
fi
( set -x; rsync -L --mkpath "$SRC_DIR"/github/workflows/tests.yaml "$REPO_PATH"/.github/workflows/ ) || exit 1
# .github/workflows/
if [ -e "$REPO_PATH/docker/compose/build.yaml" ]; then
    ( set -x; rsync -L --mkpath "$SRC_DIR"/github/workflows/docker-compose-ghcr-build-push.yaml "$REPO_PATH"/.github/workflows/ ) || exit 1
fi
if [ -e "$REPO_PATH/docker/compose/prod.yaml" ]; then
    echo test
   # ( set -x; rsync -L --mkpath "$SRC_DIR"/github/scripts/docker-compose-prod-down.sh "$REPO_PATH"/.github/scripts/ ) || exit 1
  #  ( set -x; rsync -L --mkpath "$SRC_DIR"/github/scripts/docker-compose-prod-up.sh "$REPO_PATH"/.github/scripts/ ) || exit 1
  #  ( set -x; rsync -L --mkpath "$SRC_DIR"/github/workflows/docker-compose-prod-down.yaml "$REPO_PATH"/.github/workflows/ ) || exit 1
  #  ( set -x; rsync -L --mkpath "$SRC_DIR"/github/workflows/docker-compose-prod-up.yaml "$REPO_PATH"/.github/workflows/ ) || exit 1
fi

if [ -e "$REPO_PATH/config/kamal.prod.yaml" ]; then
    ( set -x; rsync -L --mkpath "$SRC_DIR"/github/workflows/kamal-ghcr-prod-action.yaml "$REPO_PATH"/.github/workflows/ ) || exit 1
fi

( set -x; find "$REPO_PATH/.scripts" -type f -not -perm +111 -exec chmod +x {} + )
