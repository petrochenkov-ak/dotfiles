#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

( set -x; "${BASH_SOURCE%/*}"/repo-django-schemas-core-gen ) || exit
( set -x; "${BASH_SOURCE%/*}"/repo-django-schemas-init-py-gen ) || exit
( set -x; "${BASH_SOURCE%/*}"/repo-django-serializers-core-gen ) || exit
( set -x; "${BASH_SOURCE%/*}"/repo-django-serializers-init-py-gen ) || exit
