#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

[ -d sql ] && {
    ( set -x; python -m python_packages_django_models_init ) || exit
}
( set -x; python -m python_packages_cleanup ) || exit
( set -x; "${BASH_SOURCE%/*}"/repo-python-packages-black ) || exit
( set -x; "${BASH_SOURCE%/*}"/repo-python-packages-isort ) || exit
