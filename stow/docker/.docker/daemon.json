{
    "experimental": true,
    "features": {
      "buildkit": true
    },
    "insecure-registries": [
      "localhost:5000"
    ],
    "builder": {
      "gc": {
        "enabled": true,
        "defaultKeepStorage": "20GB"
      }
    },
   "log-driver": "json-file",
    "log-opts": {
      "max-size": "1m",
      "max-file": "1"
    },
    "registry-mirrors": [
      "https://gcr.io",
      "https://daocloud.io",
      "https://huecker.io",
      "https://timeweb.cloud",
      "https://docker4u.ru"
    ]
}
