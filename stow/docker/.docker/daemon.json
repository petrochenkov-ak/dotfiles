{
  "experimental": true,
  "features": {
    "buildkit": true
  },
  "max-concurrent-uploads": 1,
  "insecure-registries": [
    "127.0.0.1:5000",
    "localhost:5000",
  ],
  "builder": {
    "gc": {
      "enabled": true,
      "defaultKeepStorage": "20GB"
    }
  },
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "1m",
    "max-file": "1"
  },
  "registry-mirrors": [
    "https://huecker.io",
    "https://docker4u.ru",
    "https://timeweb.cloud"
  ]
}
