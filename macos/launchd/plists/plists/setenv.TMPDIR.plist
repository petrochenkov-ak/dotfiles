<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>setenv.TMPDIR</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>[ -d "/Volumes/ExternalSSD/ssd-external" ] &amp;&amp; launchctl setenv TMPDIR /Volumes/ExternalSSD/ssd-external</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
